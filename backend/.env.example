# --- Core ---
# Async SQLAlchemy URL. SQLite for dev, PostgreSQL for prod.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pbigen

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Fernet master key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- LLM provider keys (optional defaults; users normally supply their own) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Generation tuning ---
MAX_RETRIES=3
SCHEMA_TOKEN_BUDGET=7000

# --- TMDL validation ---
# Path to Tabular Editor 2 CLI binary. If unset/missing, TMDL validation degrades to
# structural-only checks (a warning is logged).
TE2_CLI_PATH=

# --- Output ---
GENERATED_DIR=./generated

# --- CORS (Streamlit frontend origin) ---
FRONTEND_ORIGIN=http://localhost:8501
