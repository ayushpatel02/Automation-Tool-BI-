# --- Core ---
# Async SQLAlchemy URL. SQLite for dev, PostgreSQL for prod.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pbigen

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Fernet master key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- LLM provider keys (optional defaults; users normally supply their own) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Generation tuning ---
MAX_RETRIES=3
SCHEMA_TOKEN_BUDGET=7000

# --- TMDL validation ---
# Path to Tabular Editor 2 CLI binary. If unset/missing, TMDL validation degrades to
# structural-only checks (a warning is logged).
TE2_CLI_PATH=

# --- Output ---
GENERATED_DIR=./generated

# --- CORS (Streamlit frontend origin; also the base URL for password-reset links) ---
FRONTEND_ORIGIN=http://localhost:8501

# --- Email (SMTP) for password reset ---
# If SMTP_HOST is left blank, password-reset emails are logged to the backend console
# instead of being sent — handy for local dev (copy the code from the logs).
#
# To actually deliver mail via Gmail:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use these values (SMTP_PASSWORD is the 16-char App Password, NOT your login
#      password — remove the spaces Google shows):
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587            # or 465 (the app auto-uses SSL on 465)
#        SMTP_USERNAME=you@gmail.com
#        SMTP_PASSWORD=your16charapppassword
#        SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@pbigen.local

# Minutes a password-reset link / code stays valid.
PASSWORD_RESET_EXPIRE_MINUTES=30
